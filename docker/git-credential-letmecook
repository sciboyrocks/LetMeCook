#!/bin/sh
# Git credential helper backed by the LetMeCook GitHub connection.
#
# Registered system-wide (see Dockerfile.code-server), so every repository in
# every project authenticates off the single dashboard login — no tokens are
# written into any repo's .git/config.

[ "$1" = "get" ] || exit 0

host=''
while IFS= read -r line; do
    [ -z "$line" ] && break
    case "$line" in
        host=*) host=${line#host=} ;;
    esac
done

[ "$host" = 'github.com' ] || exit 0
[ -n "$LETMECOOK_API_KEY" ] || exit 0

token=$(curl -fsS --max-time 5 \
    -H "X-API-Key: ${LETMECOOK_API_KEY}" \
    "${LETMECOOK_URL:-http://api:3000}/api/github/token" 2>/dev/null |
    sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

[ -n "$token" ] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
